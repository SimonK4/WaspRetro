const
  SEP = DirectorySeparator;

procedure TerminateScript(reason: String); overload;
begin
  WriteLn('[AsyncMover]: Terminating: ' + reason);
  TerminateScript();
end;


function TStringArray.Find(const value: String): Integer; constref;
begin
  for Result := 0 to High(Self) do
    if value = Self[Result] then
      Exit;
  Result := -1;
end;

function TStringArray.Contains(const value: String): Boolean; constref;
begin
  Result := Self.Find(value) > -1;
end;

function TStringArray.Merge(glue:String=''): String; constref;
var
  i:Int32;
begin
  if Length(Self) = 0 then
    Exit();

  Result := Self[0];
  for i:=1 to High(Self) do
    Result += glue + Self[i];
end;

function BackupFile(filePath: String): Boolean;
var
  f: Int32;
  contents: String;
begin
  f := OpenFile(filePath, False);
  if not ReadFileString(f, contents, FileSize(f)) then
    Exit;

  CloseFile(f);
  Result := WriteFileContents(filePath + '.bak', contents, False);
end;

function RestoreFile(filePath: String): Boolean;
var
  f: Int32;
  contents: String;
begin
  f := OpenFile(filePath + '.bak', False);
  if not ReadFileString(f, contents, FileSize(f)) then
    Exit;

  CloseFile(f);
  Result := WriteFileContents(filePath, contents, False);
  DeleteFile(filePath + '.bak');
end;

function DirectoryIsEmpty(const directory: String): Boolean;
begin
  Result := (FindFiles(directory, False) = []) and (FindDirectories(directory, False) = []);
end;

function DeleteFiles(const directory: String; skip: TStringArray = []): Boolean;
  function _SkipFile(dir: String): Boolean;
  var
    s: String;
  begin
    for s in skip do
      if Pos(s, dir) > 0 then
        Exit(True);
  end;

var
  f: String;
begin
  for f in FindFiles(directory, True) do
  begin
    if _SkipFile(f) then
      Continue;

    if not DeleteFile(f) then
      Exit;
  end;

  Result := True;
end;

function DeleteSubDirectories(const directory: String; deleteRoot: Boolean; skip: TStringArray = []): Boolean;

  function _SkipDirectory(dir: String): Boolean;
  var
    s: String;
  begin
    for s in skip do
      if Pos(s, dir) > 0 then
        Exit(True);
  end;

  function _GetParent(dir: String): String;
  var
    strings: TStringArray;
  begin
    strings := Explode(DirectorySeparator, dir);
    SetLength(strings, High(strings));
    Result := strings.Merge(DirectorySeparator);
  end;

var
  directories, parents: TStringArray;
  i: Int32;
begin
  directories := FindDirectories(directory, True);

  while directories <> [] do
  begin
    for i := High(directories) downto 0 do
    begin
      if _SkipDirectory(directories[i]) then
      begin
        parents += _GetParent(directories[i]);
        Delete(directories, i, 1);
        deleteRoot := False;
        Continue;
      end;

      if not parents.Contains(directories[i]) and not DeleteDirectory(directories[i], False) then
        Exit;
      Delete(directories, i, 1);
    end;
  end;

  Result := not deleteRoot or DeleteDirectory(directory, False);
end;

function RMDir(const directory: String; deleteRoot: Boolean; skip: TStringArray = []): Boolean;
begin
  if not DeleteFiles(directory, skip) then
    Exit;

  Result := DeleteSubDirectories(directory, deleteRoot, skip);
end;


function IsFileLocked(path: String): Boolean;
begin
  if not FileExists(path) then
    Exit;

  if not BackupFile(path) then
    TerminateScript('Failed to backup file: ' + path);

  Result := not DeleteFile(path);

  if Result then
    DeleteFile(path + '.bak')
  else if not RestoreFile(path) then
    TerminateScript('Failed to restore file: ' + path);
end;

function FindLockedPlugins(): TStringArray;
const
  PATHS = [
    IncludePath + 'SRL'   + SEP + 'plugins' + SEP + 'libremoteinput' + SEP,
    IncludePath + 'SRL-T' + SEP + 'plugins' + SEP + 'libremoteinput' + SEP
  ];
var
  path, plugin: String;
begin
  for path in PATHS do
    for plugin in FindFiles(path, False) do
      if IsFileLocked(plugin) then
        Result += plugin;
end;


procedure KillWindowByClass(name: String);
var
  window: TOSWindow;
begin
  for window in GetWindows().GetByClass(name) do
    window.Kill();
end;

procedure KillSimbas();
var
  windows, simbas: TOSWindowArray;
  win: TOSWindow;
begin
  windows := GetWindows();
  simbas := windows.GetByTitleAndClass('Output,File Browser,Editor,Function List', 'Window');

  if MessageDlg('Close Simba', 'Simba needs to be restarted.',
     TMsgDlgType.mtConfirmation, [mbOK, mbAbort]) = 3 then
    TerminateScript('You need to close all Simba windows to update SRL.');

  for win in simbas do
    win.Kill();

  TerminateScript();
end;


procedure UnlockPlugins();
var
  locked: TStringArray;
  plugin: String;
begin
  locked := FindLockedPlugins();
  if locked = [] then
    Exit;

  if MessageDlg('Close RuneScape', 'RS Clients need to be closed to update this package.',
     TMsgDlgType.mtConfirmation, [mbOK, mbAbort]) = 3 then
    TerminateScript('You need to close your RS Clients to update SRL.');

  KillWindowByClass('SunAwtCanvas');

  for plugin in locked do
    if IsFileLocked(plugin) then
    begin
      KillWindowByClass('Jagex Launcher');
      Break;
    end;

  for plugin in locked do
    if IsFileLocked(plugin) then
    begin
      KillSimbas();
      Break;
    end;
end;


procedure MoveFiles(origin, pkg: String);
var
  paths, files: TStringArray;
  path, f, fPath, destination: String;
begin
  paths := GetDirectories(origin + pkg + SEP);
  if Length(paths) <> 1 then
    TerminateScript('The ' + pkg + ' download is empty or has unexpected things inside.');

  destination := IncludePath + pkg + SEP;
  if DirectoryExists(destination) and not RMDir(destination, True, ['.git', 'overrides.simba']) then
    TerminateScript('Failed to delete old ' + pkg + ' library');
  if not ForceDirectories(destination) then
    TerminateScript('Failed to create path: ' + destination);

  path := origin + pkg + SEP + paths[0] + SEP;
  files := FindFiles(path, True);

  for f in files do
  begin
    fPath := Replace(f, path, '', [rfReplaceAll]);
    if Pos('.git', fPath) > 0 then
      Continue;

    if Pos('overrides.simba', fPath) > 0 then
      Continue;

    if not ForceDirectories(destination + ExtractFilePath(fPath)) then
      TerminateScript('Failed to create path: ' + destination + ExtractFilePath(fPath));

    if not CopyFile(f, destination + fPath, False) then
      TerminateScript('Failed to copy file: ' + fPath);

    DeleteFile(f);
    if (FindFiles(ExtractFilePath(f), True) = []) and (FindDirectories(ExtractFilePath(f), True) = []) then
      DeleteDirectory(ExtractFilePath(f), False);
  end;

  RMDir(origin + pkg, True);
end;

var
  pkg: String;

procedure Free();
begin
  CloseFile(CreateFile({$MACRO CURRENT_DIRECTORY} + 'mover-' + LowerCase(pkg) + '.done'));
end;

begin
  pkg := GetProcessParameter('pkg');

  if FileExists({$MACRO CURRENT_DIRECTORY} + 'mover-' + LowerCase(pkg) + '.done') then
    DeleteFile({$MACRO CURRENT_DIRECTORY} + 'mover-' + LowerCase(pkg) + '.done');

  AddOnTerminate(@Free);

  case LowerCase(pkg) of
    'srl-t', 'srlt', 'srl': UnlockPlugins();
  end;

  WriteLn('[AsyncMover]: Moving ', pkg, ' files, this will take a while.');
  MoveFiles(GetProcessParameter('origin'), pkg);
end;
