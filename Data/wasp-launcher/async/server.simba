//Credits: Slacky
function String.After(SubStr: String; p: Int32): String; constref;
begin
  Inc(p, Length(SubStr));
  Result := Copy(Self, p, Length(Self) - p + 1);
end;

type
  TSimbaServerClient = record
    ID: Int32;
    IP, Port: String;
    IsSetup: Boolean;
  end;

  TSimbaServer = record
    ID: Int32;
    IP, Port: String;
    Client: TSimbaServerClient;
  end;

procedure TSimbaServerClient.CloseAndFree();
begin
  if not Self.IsSetup then Exit;
  CloseSocket(Self.ID);
  FreeSocket(Self.ID);
  Self.IsSetup := False;
end;

procedure TSimbaServerClient.WriteString(s: string);
begin
  SendSocket(Self.ID, s);
end;

function TSimbaServerClient.SendHTML(content: String): Boolean;
var
  headers, html: String;
begin
  html :=
  '<!DOCTYPE html>' + LineEnding +
    '<html>' + LineEnding +
    '  <head>' + LineEnding +
    '    <meta charset=''UTF-8''>' + LineEnding +
    '    <link rel=''icon'' href=''https://waspscripts.com/favicon.png''>' + LineEnding +
    '    <meta name=''viewport'' content=''width=device-width''>' + LineEnding +
    '    <title>WaspScripts</title>'  + LineEnding +
    '    <meta name=''description'' content=''WaspScripts Simba Login page''>' + LineEnding +
    '    <style>' + LineEnding +
    '      body {' + LineEnding +
    '         background-color: #222324;' + LineEnding +
    '         color: white;' + LineEnding +
    '         display: flex;' + LineEnding +
    '         justify-content: center;' + LineEnding +
    '         height: 100vh;' + LineEnding +
    '         text-align: center;' + LineEnding +
    '         flex-direction: column;' + LineEnding +
    '      }' + LineEnding +
    '    </style>' + LineEnding +

    '  </head>' + LineEnding +
    ' <body>' + LineEnding +
        content + LineEnding +
    ' </body>' + LineEnding +
  '</html>';

  headers += 'HTTP/1.1 200 OK' + #13#10;
  headers += 'Content-Type: text/html'+#13#10;
  headers += 'Connection: close'+#13#10;
  headers += 'Content-Length: ' + IntToStr(Length(html))+#13#10#13#10;

  Result := True;
  try
    Self.WriteString(headers + html);
  except
    Exit(False);
  end;
end;


function TSimbaServerClient.Read(): String; overload;
begin
  Result := RecvSocketStr(Self.ID);
end;


procedure TSimbaServer.CloseAndFree();
begin
  CloseSocket(Self.ID);
  FreeSocket(Self.ID);
end;

function TSimbaServer.AttemptSocketBind(): Boolean;
begin
  try BindSocket(Self.ID, Self.IP, Self.Port); except Exit end;
  Result := True;
end;

procedure TSimbaServer.Setup();
var
  attempt: Int32;
begin
  Self.ID   := CreateSocket();
  Self.IP   := '127.0.0.1';
  Self.Port := '5217';

  for attempt := 0 to 200 do
  begin
    if Self.AttemptSocketBind() then Break;
    Sleep(100);
  end;

  ListenSocket(Self.ID);
  Self.Client.ID := -1;
end;

procedure TSimbaServer.AcceptClient();
begin
  Self.Client.IsSetup := True;
  Self.Client.ID := AcceptSocket(Self.ID);
  SocketInfo(Self.Client.ID, Self.Client.IP, Self.Client.Port);
end;

function TSimbaServer.Listen(): String;
var
  tmp, header, path: String;
  i: Int32
begin
  try SetSocketTimeout(Self.Client.ID, 2000); except Exit; end;

  //Writeln('Connection from: ', client.IP, ':', client.Port);

  repeat
    try
      tmp := Self.Client.Read();
      header += tmp;
    except
      Exit; //client is DC'ed.
    end;
  until tmp = '';

  path := Between('GET ', ' HTTP/1.1', header);

  i := Pos('?error=', path);
  if i > 0 then
    if not client.SendHTML('<h1>Login failed with error message:</h1><p>' + path.After('?error=', i) + '</p><h2>Close this page and try again.</h2>') then Exit;

  i := Pos('?code=', path);
  if i > 0 then
  begin
    Result := path.After('?code=', i);
    if not Self.Client.SendHTML('<h1>You''ve successfully logged in!</h1><h2>You can now close this page.</h2>') then Exit;
  end;

  Self.Client.CloseAndFree();
end;

var
  HealthChecker: TTimer;
  Timeout: UInt64;
  Server: TSimbaServer;
  {$IFDEF SIMBAHEADLESS}
  LauncherPID: PtrUInt;
  {$ENDIF}
  Code: String;

procedure HealthCheck(sender: TObject);
begin
  if (GetTickCount() <= Timeout) and
      {$IFDEF SIMBAHEADLESS} IsProcessRunning(LauncherPID) and {$ENDIF}
      not FileExists({$MACRO CURRENT_DIRECTORY} + 'server-stop') then Exit;

  DeleteFile({$MACRO CURRENT_DIRECTORY} + 'server-stop');
  CloseFile(CreateFile({$MACRO CURRENT_DIRECTORY} + 'server-failed.done'));

  TTimer(sender).setEnabled(False);
  RaiseException('Server timed out!');
end;

procedure RunHealthCheck();
begin
  HealthChecker.SetOnTimer(@HealthCheck);
  HealthChecker.SetEnabled(True);
end;

begin
  DeleteFile({$MACRO CURRENT_DIRECTORY} + 'server-stop');
  {$IFDEF SIMBAHEADLESS}
  LauncherPID := Variant(GetProcessParameter('LauncherPID'));
  {$ENDIF}

  Server.Setup();
  AddOnTerminate(@Server.CloseAndFree);
  AddOnTerminate(@Server.Client.CloseAndFree);
  AddOnTerminate(@HealthChecker.Free);

  Timeout := GetTickCount() + 5 * 60 * 1000;
  HealthChecker.Init(nil);

  HealthChecker.SetInterval(150);
  Sync(@RunHealthCheck);

  repeat
    Server.AcceptClient();
    code := Server.Listen();
  until code <> '';

  WriteFileContents({$MACRO CURRENT_DIRECTORY} + 'server-success.done', code, False);

  HealthChecker.setEnabled(False);
end;
