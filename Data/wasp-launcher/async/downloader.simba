var
  timeout: TTimer;
  http: Int32;
  url, pkg: String;
  t: UInt64;

procedure OnTimer({$H-}sender: TObject);{$H+}
begin
  WriteLn('[AsyncDownloader]: Downloading ', pkg, '...');

  if GetTickCount() > t then
  begin
    WriteLn('[AsyncDownloader]: If this has taken over 5 minutes please restart Simba.');
    WriteLn('[AsyncDownloader]: If you are rate limited you need to wait 1 hour.');
    t := GetTickCount() + 120000;
  end;
end;

procedure Free();
begin
  timeout.setEnabled(False);
  timeout.Free();
  FreeHTTPClient(http);
  CloseFile(CreateFile({$MACRO CURRENT_DIRECTORY} + 'downloader-' + LowerCase(pkg) + '.done'));
end;

procedure RunTimer();
begin
  timeout.setOnTimer(@OnTimer);
  timeout.setEnabled(True);
end;

begin
  url := GetProcessParameter('url');
  pkg := GetProcessParameter('pkg');

  if FileExists({$MACRO CURRENT_DIRECTORY} + 'downloader-' + LowerCase(pkg) + '.done') then
    DeleteFile({$MACRO CURRENT_DIRECTORY} + 'downloader-' + LowerCase(pkg) + '.done');

  timeout.Init(nil);
  timeout.SetName('downloader_timeout');
  timeout.SetInterval(20000);
  http := InitializeHTTPClient(True);
  Sync(@RunTimer);
  AddOnTerminate(@Free);

  WriteLn('[AsyncDownloader]: Downloading ', pkg, ', this might take a while.');
  t := GetTickCount() + 120000;

  try
    if GetHTTPPageEx(http, url, GetProcessParameter('destination')) = 200 then
      WriteLn('[AsyncDownloader]: ' + pkg + ' downloaded.')
    else
      WriteLn('[AsyncDownloader]: Failed to download: ' + url);
  except
    WriteLn('[AsyncDownloader]: Error: ', GetExceptionMessage());
  end;
end;
