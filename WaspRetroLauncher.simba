function createProperties(ID:integer; name:String):boolean;
var
  runeliteFolder:String := GetEnvironmentVariable("userprofile") + Directoryseparator+".runelite"+Directoryseparator+"profiles2\";
begin
  if FileExists(runeliteFolder + name + '-' + ToStr(id) + '.properties') then
    if not DeleteFile(runeliteFolder + name + '-' + ToStr(id) + '.properties') then
      TerminateScript();

  WriteFileContents(runeliteFolder + name + '-' + ToStr(id) + '.properties', GetProfileFileString(), False);
end;

procedure addProfileToFile(id:int32; name:String);
var
  hasJson:boolean;
  x:int32;
  origJSONObj,tempJSONObj : TJSONObject;
  jsonArr, builtJSONData  : TJSonArray;
  Path:String;
begin
  path := GetEnvironmentVariable('userprofile') + DirectorySeparator + '.runelite' + DirectorySeparator + 'profiles2' + DirectorySeparator ;

  origJSONObj.Init(ReadFileContents(path+'profiles.json'));
  builtJSONData.Init();
  jsonArr := origJSONObj.getJSONArray('profiles');

  for x:=0 to jsonArr.length-1 do
  begin
    tempJSONObj := jsonArr.getJSONObject(x);

    if (tempJSONObj.getInt("id") = id) and (tempJSONObj.getString("name") = name) then
    begin
      writeln("There's a json entry for "+name);
      tempJSONObj.remove('active');
      tempJSONObj.Put('active', True);

      tempJSONObj.remove('sync');
      tempJSONObj.Put('sync', False);

      tempJSONObj.remove('rev');
      tempJSONObj.Put('rev', -1);

      tempJSONObj.remove('defaultForRsProfiles');

      builtJSONData.put(tempJSONObj);
      hasJSon := true;
      continue;
    end;

    if (tempJSONObj.getInt("id") = id) then continue; // failsafes I guess?
    if (tempJSONObj.getString("name") = name) then continue;

    tempJSONObj.remove('active');
    tempJSONObj.Put('active', false);

    builtJSONData.put(tempJSONObj);
  end;

  if not hasJson then
  begin
    writeln("Createing json!");
    tempJSONObj.Init('{"id":' + ToStr(id) + ',"name":"' + name + '","sync":false,"active":true,"rev":-1}');
    builtJSONData.put(tempJSONObj);
  end;

  origJSONObj.remove("profiles");
  origJSONObj.put('profiles', builtJSONData);

  if not WriteFileContents(Path+'profiles.json', origJSONObj.ToString(), False) then TerminateScript();
end;

procedure addRLSTuff(ID:int32; name:string);
begin
  createProperties(ID, name);
  addProfileToFile(ID, name);
end;

function GetDPI(): Int32;
var
  tmp: TFont;
begin
  tmp.Init();
  Result := tmp.GetPixelsPerInch();
  tmp.Free();
end;

function hasIncludesFolder: boolean;
begin
  if not DirectoryExists(appPath + "Includes") then
    if not CreateDirectory(appPath + "Includes") then
      terminatescript();
end;

function deleteZip(zipName:string): boolean;
begin
  if not fileExists(apppath+"Includes"+directoryseparator+zipName) then exit(true);
  result := deleteFile(apppath+"Includes"+directoryseparator+zipName);
end;

function TRetroForm.hasFinishedFile(str:String): boolean;
begin
  result:= fileExists(appPath+str);
end;

function TRetroForm.deleteFinishedFile(str:String): boolean;
begin
  result:= deleteFile(appPath+str);
end;

procedure TRetroForm.downloadSRLT(Sender: TObject);
begin
  self.ButtonData.srltButton.setEnabled(False);
  theForm.InstallSRLTDeadline := UnixTime+120;
  theForm.InstallSRLTTimer.SetEnabled(True);

  RunScript(AppPath+"Github_Installer.simba", [
  "githubLink="+srlT_GithubLink,
  "zipName=SRL-T.zip",
  "folderName=SRL-T",
  "includes="+AppPath+'Includes'+directorySeparator]);
end;

procedure TRetroForm.downloadWaspLib(Sender: TObject);
begin
  self.ButtonData.wasplibButton.setEnabled(false);
  theForm.InstallWaspLibDeadline := UnixTime+120;
  theForm.InstallWaspLibTimer.SetEnabled(True);

  RunScript(AppPath+"Github_Installer.simba", [
  "githubLink="+waspLib_GithubLink,
  "zipName=WaspLib.zip",
  "folderName=WaspLib",
  "includes="+AppPath+'Includes'+directorySeparator]);
end;

procedure TRetroForm.installRuneliteProfile(Sender: TObject);
begin
  addRLSTuff(runeliteID,runeliteName);
  self.ButtonData.waspProfile.setEnabled(false);
end;

procedure TRetroForm.launchRuneliteEXE(Sender: TObject);
var
  str:string := directorySeparator;
begin
  addRLSTuff(runeliteID,runeliteName);
  runcommand("C:"+str+"Program Files"+str+"Jagex Launcher"+str+"JagexLauncher.exe", []);
end;

procedure tRetroform.getData();
begin
  self.compData.monitorWidthForm  := round(GetDPI*10);
  self.compData.monitorHeightForm := round(getDPI*7);
  self.compData.DPI               := getDPI();
end;

procedure installAsync(simbaName:String);
begin
  if not WriteFileContents(AppPath+simbaName+".simba", websitedownloadCode, False) then
    writeln("Failed to install the async thing");
end;

procedure TRetroForm.CheckSRLTInstaller(Sender: TObject);
var
  incPath:string := AppPath + directorySeparator+ "Includes"+ directoryseparator;
begin
  if FileExists(incPath+ 'SRL-TCleaning') then
  begin
    DeleteFile(incPath+ 'SRL-TCleaning');
    Self.ButtonData.SRLTButton.SetCaption('SRL-T Cleaning!');
  end;

  if FileExists(incPath+ 'SRL-TDownloading') then
  begin
    DeleteFile(incPath+ 'SRL-TDownloading');
    Self.ButtonData.SRLTButton.SetCaption('SRL-T Downloading!');
  end;

  if FileExists(incPath+ 'SRL-TUnzipping') then
  begin
    DeleteFile(incPath+ 'SRL-TUnzipping');
    Self.ButtonData.SRLTButton.SetCaption('SRL-T unzipping!');
  end;

  if FileExists(incPath+ 'SRL-TDone') then
  begin
    DeleteFile(incPath+ 'SRL-TDone');
    TTimer(Sender).SetEnabled(False);
    Self.ButtonData.SRLTButton.SetCaption('SRL-T Updated!');
  end;

  if FileExists(incPath+ 'SRL-TFailed') then
  begin
    DeleteFile(incPath+ 'SRL-TFailed');
    self.ButtonData.srltButton.setEnabled(true);
    TTimer(Sender).SetEnabled(False);
    Self.ButtonData.SRLTButton.SetCaption('SRL-T Failed!');
  end;

  if unixTime >= Self.InstallSRLTDeadline then
  begin
    self.ButtonData.srltButton.setEnabled(true);
    TTimer(Sender).SetEnabled(False);
    Self.ButtonData.SRLTButton.SetCaption('SRL-T timed out!');
  end;
end;

procedure TRetroForm.CheckWaspLibInstaller(Sender: TObject);
var
  incPath:string := AppPath + directorySeparator+ "Includes"+ directoryseparator;
begin
  if FileExists(incPath+ 'WaspLibCleaning') then
  begin
    DeleteFile(incPath+ 'WaspLibCleaning');
    Self.ButtonData.WaspLibButton.SetCaption('WaspLib Cleaning!');
  end;

  if FileExists(incPath+ 'WaspLibDownloading') then
  begin
    DeleteFile(incPath+ 'WaspLibDownloading');
    Self.ButtonData.WaspLibButton.SetCaption('WaspLib Downloading!');
  end;

  if FileExists(incPath+ 'WaspLibUnzipping') then
  begin
    DeleteFile(incPath+ 'WaspLibUnzipping');
    Self.ButtonData.WaspLibButton.SetCaption('WaspLib Unzipping!');
  end;

  if FileExists(incPath+ 'WaspLibDone') then
  begin
    DeleteFile(incPath+ 'WaspLibDone');
    TTimer(Sender).SetEnabled(False);
    self.ButtonData.WaspLibButton.setEnabled(false);
    Self.ButtonData.WaspLibButton.SetCaption('WaspLib Done!');
  end;

  if FileExists(incPath+ 'WaspLibFailed') then
  begin
    DeleteFile(incPath+ 'WaspLibFailed');
    self.ButtonData.WaspLibButton.setEnabled(true);
    TTimer(Sender).SetEnabled(False);
    Self.ButtonData.WaspLibButton.SetCaption('WaspLib Failed!');
  end;

  if unixTime >= Self.InstallWaspLibDeadline then
  begin
    self.ButtonData.WaspLibButton.setEnabled(true);
    TTimer(Sender).SetEnabled(False);
    Self.ButtonData.WaspLibButton.SetCaption('WaspLib timed out!');
  end;
end;

function tstringarray.trimStrings(stringArray:TStringArray):tstringarray;
var
  x,y:int32;
  temp:string;
begin
  for x:=0 to high(self) do
    for y:=0 to high(stringarray) do
      if self[x].Contains(stringarray[y]) then
        self[x] := stringreplace(self[x],stringarray[y],'',  [rfreplaceall]);

  result := self;
end;

procedure tRetroForm.findScripts();
var
  str1:string:=GetEnvironmentVariable("Userprofile") + Directoryseparator+ 'Downloads'+ Directoryseparator;
  str2:string:=apppath+"Scripts"+directoryseparator;
  initialPass,filteredPass:tstringarray;
  x:int32;
begin
  initialPass+=findFiles(str1,['.simba']);
  initialPass+=findFiles(str2,['.simba']);

  for x:=0 to high(initialPass) do
    if readfilecontents(initialPass[x]).contains('{$I WaspLib/osr.simba}') then
      filteredPass += initialPass[x];

  for x:=0 to high(filteredPass) do
    self.rawFilesLoc += filteredPass[x];

  self.filteredNames := filteredPass.trimStrings([str1,str2,'.simba']);
end;

procedure tRetroForm.onClickRefreshScripts(Sender:TObject);
var
  x:int32;
begin
  self.theList.ScrollBy(1,1);
  self.theList.getItems.BeginUpdate();
  try
    self.findScripts();
    self.theList.Clear();
    self.theList.Update();
    self.updateListItems();

  finally
    self.thelist.getItems.EndUpdate();
  end;
end;

procedure tRetroForm.onClickLaunchScript(Sender:TObject);
begin
  if self.theList.getItemIndex = -1 then exit;
  SimbaOpenInTab(self.rawFilesLoc[self.theList.getItemIndex]);
end;

procedure tretroform.openSettingsSearcher(Sender:TObject);
begin
  SimbaOpenInTab(appPath+"settings_searcher.simba");
end;

procedure TRetroForm.Show();
begin
  try
    Self.Form.Showmodal();
  except
    Writeln(GetExceptionMessage());
  finally
    Self.Form.Free();
  end;
end;

procedure TRetroForm.Run;
begin
  sync(@self.show);
end;

procedure tRetroForm.setForm();
begin
  theForm.Form.Init(nil);
  theForm.Form.setName("WaspRetro");

  theForm.Form.setWidth(self.compData.monitorWidthForm);
  theForm.Form.setHeight(self.compData.monitorHeightForm);
  theForm.Form.setPosition(poScreenCenter);
  theForm.Form.getConstraints().SetInterfaceConstraints(
                                self.compData.monitorWidthForm,
                                self.compData.monitorHeightForm,
                                self.compData.monitorWidthForm,
                                self.compData.monitorHeightForm
                                );
end;

procedure tRetroForm.setButtons();
begin
  self.ButtonData.SRLTButton.Init(nil);
  self.ButtonData.SRLTButton.setParent(self.Form);
  self.ButtonData.SRLTButton.setCaption("SRL-T Download");
  self.ButtonData.SRLTButton.SetBounds(
    Round((self.compData.monitorWidthForm*0.50)/(Round(self.compData.DPI/100))),
    Round((self.compData.monitorHeightForm*0.10)/(Round(self.compData.DPI/100))),
    round((self.compData.monitorWidthForm*0.48)/(Round(self.compData.DPI/100))),
    Round((self.compData.monitorHeightForm*0.10)/(Round(self.compData.DPI/100)))
    );
  self.ButtonData.SRLTButton.getFont().setSize(Round((self.compData.monitorWidthForm*0.15)/(Round(self.compData.DPI/20))));
  self.ButtonData.SRLTButton.setOnClick(@downloadSRLT);

  self.ButtonData.wasplibbutton.Init(nil);
  self.ButtonData.wasplibbutton.setParent(self.Form);
  self.ButtonData.wasplibbutton.setCaption("WaspLib Download");
  self.ButtonData.wasplibbutton.SetBounds(
    Round((self.compData.monitorWidthForm*0.50)/(Round(self.compData.DPI/100))),
    Round((self.compData.monitorHeightForm*0.25)/(Round(self.compData.DPI/100))),
    round((self.compData.monitorWidthForm*0.48)/(Round(self.compData.DPI/100))),
    Round((self.compData.monitorHeightForm*0.10)/(Round(self.compData.DPI/100)))
    );
