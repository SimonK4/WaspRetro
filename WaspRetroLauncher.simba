procedure tRetroForm.setList();
var
  x:int32;
begin
  self.theList.Init(nil);
  self.theList.setParent(self.Form);
  self.theList.getFont().setSize(Round((self.compData.monitorWidthForm*0.08)/(Round(self.compData.DPI/20))));

  self.theList.SetBounds(
    Round((self.compData.monitorWidthForm*0.05)/(Round(self.compData.DPI/100))),
    Round((self.compData.monitorHeightForm*0.10)/(Round(self.compData.DPI/100))),
    round((self.compData.monitorWidthForm*0.37)/(Round(self.compData.DPI/100))),
    Round((self.compData.monitorHeightForm*0.70)/(Round(self.compData.DPI/100))) //length
  );
  self.updateListItems();
end;

begin
  cleardebug();
  hasIncludesFolder();
  theForm.getData();
  theForm.findScripts();
  theform.setForm();
  theForm.setButtons();
  theForm.setList();
  installAsync("Github_Installer");
  cleardebug();

  theForm.run();
end.
