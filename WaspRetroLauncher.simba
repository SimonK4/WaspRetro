
{
  A launcher that downloads the SRL-T and WaspLib from github.
  The files are extracted and leftover data is deleted.
  0 Includes are required, only simba




}

var
  srlT_GithubLink:string := "https://github.com/SimonK4/SRL-T/archive/refs/heads/master.zip";
  waspLib_GithubLink:string := "https://github.com/SimonK4/WaspLib/archive/refs/heads/master.zip";
  runeliteID:int32:= 696969;
  runeliteName:string:= "WaspRetro";

type
  usefulData = record
    DPI,
    monitorWidthForm, monitorHeightForm, textSize: int32;
  end;

  tRetroForm = record
    Form: TForm;
    theList:TListBox;

    rawFilesLoc, filteredNames:TStringArray;

    ButtonData : record
      srltButton, wasplibButton, waspProfile, launchRunelite,
      settingsSearcher, refreshScripts, launchScript: TButton;

      srltTime, waspLibTime:int64;
    end;
    InstallSRLTTimer, InstallWaspLibTimer:TTimer;
    InstallSRLTDeadLine, InstallWaspLibDeadLine:Int64;
    compData: usefulData;
  end;

var
  theForm :tRetroForm;

function String.Contains(subString: String): Boolean; constref;
begin
  Result := Pos(subString,self) > 0;
end;

procedure tretroForm.updateListItems();
var
  x:int32;
begin
  for x:=0 to high(self.filteredNames) do
    self.theList.AddItem(filteredNames[x], nil);
end;

function websitedownloadCode(): string;
begin
Result += "Var" + lineending;
Result += " GithubLink, ZipName, FolderName,IncludesPath: String;" +lineending+lineending;

Result += "function deleteZip(zipName:string): boolean;" + LineEnding;
Result += "begin" + LineEnding;
Result += "  if not fileExists(apppath+'Includes'+directoryseparator+zipName) then exit(true);" + LineEnding;

Result += "  result := deleteFile(apppath+'Includes'+directoryseparator+zipName);" + LineEnding;
Result += "end;" + LineEnding+LineEnding;

Result += "procedure cleaning(folder,includepath:string); " + LineEnding;
Result += "var " + LineEnding;
Result += "  strings:tstringarray:= ['zip-master', folder+'Cleaning', folder+'Failed', " + LineEnding;
Result += "  folder+'Done', folder+'Downloading', folder+'.zip']; " + LineEnding;
Result += "  str:string; " + LineEnding;
Result += "begin " + LineEnding;
Result += "  for str in strings do " + LineEnding;
Result += "    if fileExists(includepath+str) then " + LineEnding;
Result += "    begin " + LineEnding;
Result += "      DeleteFile(includepath+str); " + LineEnding;
Result += "    writeln('Cleaning file: '+str); " + LineEnding;
Result += "    end; " + LineEnding;
Result += "end; " + LineEnding;

Result += "procedure createStatusFile(path,name:string); "+ LineEnding;
Result += "var x:int32; "+ LineEnding;
Result += "begin "+ LineEnding;
Result += "  x:=createfile(path+name);  "+ LineEnding;
Result += "  closeFile(x);"+ LineEnding;
Result += "end; "+ LineEnding+ LineEnding;

Result += "function DownloadFile(githublink, filepath, zipname:string):boolean; " + LineEnding;
Result += "var " + LineEnding;
Result += "  myClient, HTTPCode: Integer; " + LineEnding;
Result += "begin " + LineEnding;
Result += "  myclient := InitializeHTTPClient(); " + LineEnding;
Result += "  try " + LineEnding;
Result += "    HTTPCode := GetHTTPPageEx(myclient, githublink, filepath+zipname); " + LineEnding;
Result += "  finally " + LineEnding;
Result += "    FreeHTTPClient(myclient); " + LineEnding;
Result += "  end; " + LineEnding;
Result += " " + LineEnding;
Result += "  if httpcode <> 200 then " + LineEnding;
Result += "  begin " + LineEnding;
Result += "    WriteLn('HTTPcode for '+zipname+ 'is '+toStr(httpCode)); " + LineEnding;
Result += "    deleteFile(filepath+zipname);" + LineEnding;
Result += "    exit(); " + LineEnding;
Result += "  end; " + LineEnding;
Result += "  if FileExists(apppath+'Includes'+directoryseparator+zipName) then exit(true); " + LineEnding;
Result += "end; " + LineEnding;

Result += "function unzippedSuccess(zipName, unzippedName:string):boolean;" + LineEnding;
Result += "begin" + LineEnding;
Result += "  if not fileExists(apppath+'Includes'+directoryseparator+zipName) then exit(false);" + LineEnding;
Result += "  UnZipFile(apppath+'Includes'+directoryseparator+zipName," + LineEnding;
Result += "            apppath+'Includes'+directoryseparator);" + LineEnding + LineEnding;
Result += "  renameFile(apppath+'Includes'+directoryseparator+ unzippedName+'-master', apppath+'Includes'+directoryseparator+unzippedName);" + LineEnding;
Result += "  if directoryExists(appPath+'Includes'+DirectorySeparator+unzippedName) then exit(true);" + LineEnding;
Result += "end;" + LineEnding+LineEnding;

Result += "function downloadLibs(gitlink, zip, folder, includeLoc:String):boolean;" + LineEnding;
Result += "begin" + LineEnding;

Result += "  createStatusFile(includeLoc, FolderName+'Cleaning'); " + lineending;

Result += "  createStatusFile(includeLoc, FolderName+'Downloading') " + lineending;
Result += "  if not downloadFile(GitLink,IncludesPath, Zip) then " + LineEnding;
Result += "  begin" + LineEnding;
Result += "    createStatusFile(includeLoc, FolderName+'Failed'); " + lineending;
Result += "    exit();" + LineEnding;
Result += "  end;;" + LineEnding+ LineEnding;

Result += "  createStatusFile(includeLoc, FolderName+'Unzipping'); " + lineending;
Result += "  if DirectoryExists(apppath+'Includes'+directoryseparator+folder) then " + LineEnding;
Result += "     deleteDirectory(apppath+'Includes'+directoryseparator+folder, false);" + LineEnding+ LineEnding;
Result += "  if not unzippedSuccess(Zip, Folder) then exit();" + LineEnding+ LineEnding;

Result += "  createStatusFile(includeLoc, FolderName+'Cleaning'); " + lineending;
Result += "  deleteZip(ZipName);" + LineEnding;
Result += "  createStatusFile(includeLoc, FolderName+'Done'); " + lineending;

Result += "  exit(true);" + LineEnding;
Result += "end;" + LineEnding+LineEnding;

Result += "Begin" + Lineending;
Result += "  GithubLink   := GetProcessParameter('githubLink');" +lineending;
Result += "  ZipName      := GetProcessParameter('zipName');" +lineending;
Result += "  FolderName   := GetProcessParameter('folderName');"+lineending;
Result += "  IncludesPath := GetProcessParameter('includes');"+lineending;
Result += "  cleaning(folderName, includesPath);"+ LineEnding;
Result += "  DownloadLibs(githubLink, ZipName, FolderName, IncludesPath);" + LineEnding;
Result += "End." + LineEnding;

end;

